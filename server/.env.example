# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database - OPTION 1: Local PostgreSQL (FREE)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classzone?schema=public"

# Database - OPTION 2: Supabase (FREE - 500MB)
# 1. Đăng ký tại: https://supabase.com (FREE)
# 2. Tạo project mới
# 3. Copy Database URL từ Settings > Database
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# JWT Secrets (Tự generate bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - Google (FREE)
# 1. Tạo project tại: https://console.cloud.google.com (FREE)
# 2. Enable Google+ API
# 3. Tạo OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# OAuth - Facebook (FREE)
# 1. Tạo app tại: https://developers.facebook.com (FREE)
# 2. Add Facebook Login product
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# File Storage - OPTION 1: Supabase Storage (FREE - 1GB)
# 1. Enable Storage trong Supabase project
# 2. Lấy credentials từ Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# File Storage - OPTION 2: Cloudinary (FREE - 25GB/month)
# Đăng ký tại: https://cloudinary.com (FREE tier)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Email - OPTION 1: Gmail SMTP (MIỄN PHÍ)
# 1. Bật 2FA cho Gmail
# 2. Tạo App Password tại: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM=ClassZone <noreply@classzone.com>

# Email - OPTION 2: Resend (FREE - 3,000 emails/month)
# Đăng ký tại: https://resend.com (FREE)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Redis (Optional - for caching)
# Local: redis://localhost:6379
# Upstash (FREE): Đăng ký tại https://upstash.com
# REDIS_URL=redis://localhost:6379
